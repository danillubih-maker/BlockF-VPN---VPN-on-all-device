{
  "manifest_version": 3,
  "name": "Block Fun Net VPN",
  "version": "4.1",
  "description": "Global standalone VPN with persistent memory and buttons for Chrome OS Flex.",
  "permissions": [
    "proxy",
    "storage",
    "declarativeNetRequest",
    "vpnProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset",
      "enabled": true,
      "path": "global_rules.json"
    }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
